# .env.example
# Sao chép file này thành .env và điền thông tin của bạn
# KHÔNG chia sẻ file .env với người khác

# --- Semantic Scholar API ---
# Đăng ký tại: https://www.semanticscholar.org/product/api
# Để trống nếu chưa có key (vẫn hoạt động nhưng rate limit thấp hơn)
SEMANTIC_SCHOLAR_API_KEY=

# --- Crossref ---
# Điền email của bạn để được ưu tiên trong "polite pool"
CROSSREF_MAILTO=your_email@example.com

# --- OpenAlex ---
# Điền email của bạn để tăng rate limit lên 100,000 req/ngày
OPENALEX_MAILTO=your_email@example.com

# --- Email SMTP (Khôi phục mật khẩu) ---
# Điền Email và App Password (Mật khẩu ứng dụng) của Gmail để gửi mã OTP
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# --- Cơ sở dữ liệu Cloud (Dành cho Deploy) ---
# Điền connection string của PostgreSQL (ví dụ từ Supabase, Render, v.v.)
# Nếu để trống, hệ thống sẽ tự động dùng SQLite cục bộ (data/scholar.db)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
